NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=otto_lms
COURSE_STORAGE_DIR=./storage/courses
MAX_SCORM_UPLOAD_MB=500
# On Render free: use Cloudflare R2 instead of local/tmp disk (see docs/Cloudflare-R2-Setup.md)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=otto-lms-courses
# R2_PREFIX=courses

# Initial / bootstrap administrators (always ADMIN; auto-created on app start)
ADMIN_EMAIL=dev@vectra-intl.com
ADMIN_PASSWORD=ChangeMeNow123!
ADMIN_FIRST_NAME=VECTRA
ADMIN_LAST_NAME=Administrator
# Comma-separated emails that are always ADMIN (created automatically if missing)
BOOTSTRAP_ADMIN_EMAILS=dev@vectra-intl.com

# Optional invitation / password-reset email delivery.
# Preferred free option on Render: Brevo HTTP API (https://www.brevo.com) — 300 emails/day.
# 1) Create a Brevo account
# 2) Settings → SMTP & API → API Keys → Create a new API key
# 3) Settings → Senders → add & verify the From address (or domain)
# 4) Set BREVO_API_KEY and MAIL_FROM below. Leave RESEND_API_KEY empty.
BREVO_API_KEY=
MAIL_FROM=Otto Group Academy <dev@vectra-intl.com>

# Optional: Resend (https://resend.com)
# RESEND_API_KEY=

# Optional SMTP (often blocked on Render free tier — prefer BREVO_API_KEY instead)
# Brevo SMTP example:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-brevo-login-email
# SMTP_PASSWORD=your-brevo-smtp-key
# SMTP_FROM=Otto Group Academy <dev@vectra-intl.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Otto Group Academy <dev@vectra-intl.com>

# Tenant / master-build branding. Use vectra for the VECTRA International LMS; otto for client skins.
LMS_TENANT=otto
LMS_PRODUCT_NAME=Otto Group Academy
LMS_CLIENT_NAME=Otto Group
LMS_VENDOR_NAME=VECTRA
LMS_VENDOR_URL=https://vectra-intl.com/

# Daily reminder for assignments not opened after N days. Call /api/cron/reminders with CRON_SECRET.
CRON_SECRET=replace-with-a-long-random-cron-secret
REMINDER_DAYS=3
