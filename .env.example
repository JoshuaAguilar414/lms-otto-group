NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=otto_lms
COURSE_STORAGE_DIR=./storage/courses
MAX_SCORM_UPLOAD_MB=500
# On Render free: use Cloudflare R2 instead of local/tmp disk (see docs/Cloudflare-R2-Setup.md)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=otto-lms-courses
# R2_PREFIX=courses

# Initial / bootstrap administrators (always ADMIN; auto-created on app start)
ADMIN_EMAIL=dev@vectra-intl.com
ADMIN_PASSWORD=ChangeMeNow123!
ADMIN_FIRST_NAME=VECTRA
ADMIN_LAST_NAME=Administrator
# Comma-separated emails that are always ADMIN (created automatically if missing)
BOOTSTRAP_ADMIN_EMAILS=dev@vectra-intl.com

# Optional invitation email delivery.
# Preferred free option: Resend (https://resend.com) — set RESEND_API_KEY.
# For Resend testing you can keep MAIL_FROM as: Otto Group Academy <onboarding@resend.dev>
RESEND_API_KEY=
MAIL_FROM=Otto Group Academy <onboarding@resend.dev>

# SMTP (SendGrid example: host smtp.sendgrid.net, user apikey, password = API key)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.xxxxxxxx
# SMTP_FROM=Otto Group Academy <dev@vectra-intl.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Otto Group Academy <dev@vectra-intl.com>
